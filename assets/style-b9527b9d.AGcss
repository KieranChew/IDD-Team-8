.headerfont {
  font-size: 20px;
  color: black;
}

.canvas {
  width: 600px;
  height: 600px;
} 

.container-line {
  position: relative;  /* Parent container to anchor the line */
  top: 0px;
  right: 1725px;
  height: 2000px;      /* Set a height for the container */
}

.line {
  position: absolute;  /* Position within the parent container */           /* Adjust how far from the left side of the container */
  width: 10px;
  height: 100%;        /* Full height of the container */
  background-color: rgba(68, 68, 68, 0.6);
  z-index: 2;
}

.canvas {
  width: 1000px;
  height: 800px;
  z-index: 1;
}

.canvas-left {
  background-image: linear-gradient(to bottom, #41f6aa, #baf97c); /* Background color with left to right linear gradient for 3D canvas */
}

/* Left-aligned content for image */
.child-left-aligned-image {
	height: 100vh; /* Image occupies 60% of viewport height */
  justify-content: flex-start; /* Align content to left */
	padding-left: 50px;
	background-color: black;
  z-index: 1;
}

/* Common styling for all alignment divs */
.alignment {
  display: flex; /* Enable flex box for alignment */
  align-items: center; /* Vertically center image and text */
  border: 1px solid black; /* Optional: visual separation for debugging purpose */
	z-index: 1;
}

/* Parent container for all three sections */
.parent-container {
  top:-50px;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column; /* Stack divs vertically */
  gap: 0px; /* Spacing between sections */
	font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
	z-index: 10;
}

.child-container {
	height: 100vh; /* Content occupies 100% of viewport height */
}
