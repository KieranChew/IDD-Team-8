.circle1 {
  width: 150px;
	height: 150px;
  border-radius: 50%;
  top: 50px;
  right: 100px; 
  position:relative;
	background: linear-gradient(to bottom, #41f6aa, #baf97c);
}

.circle2 {
	width: 175px;
	height: 150px;
  border-radius: 50%;
  top: 50px;
  right: 400px; 
  position:relative;
	background: linear-gradient(to bottom, #41f6aa, #baf97c); /* creates a gradient text effect */
}

.circle3 {
  width: 42px;
  height: 35px; /* Adjusted for a perfect circle */
  border-radius: 50%;
  top: 0px;
  right: 1700px;
  position: relative;
  border-style: solid;
  border-width: 2px;
  border-color:rgb(255, 255, 255);
  background-color: transparent; /* Starts with a transparent background */
  transition: background-color 0.4s ease; /* Smooth background transition */
  z-index: 8;
}

.circle4 {
	width: 215px;
	height: 185px;
  border-radius: 50%;
  top: 50px;
